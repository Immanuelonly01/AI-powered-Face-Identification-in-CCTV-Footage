# =============================
# 🧠 PYTHON / FLASK BACKEND
# =============================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/
ENV/
.venv/
backend/venv/

# Flask instance folder (contains config, uploads, etc.)
instance/

# Flask cache / sessions / compiled templates
*.db
*.sqlite3
*.pyc
*.pyo
*.pyd
*.log
*.pot
*.mo
*.swp
*.swo
*.bak
*.tmp
*.pid
*.seed

# Configuration files that may contain secrets
config.py
*.env
.env
.env.*
.env.local
.env.production
.env.development

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Flask-Migrate files
migrations/__pycache__/
migrations/*.pyc

# IDE / editor specific
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS-specific files
.DS_Store
Thumbs.db

# =============================
# ⚛️ REACT FRONTEND
# =============================

# Node modules & build outputs
node_modules/
frontend/node_modules/
frontend/build/
frontend/dist/

# Debug and temporary files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml
*.tgz

# Local environment variables
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.production
frontend/.env.test

# Misc cache
*.log
*.cache/
*.eslintcache
*.tsbuildinfo

# React editor/IDE files
frontend/.vscode/
frontend/.idea/

