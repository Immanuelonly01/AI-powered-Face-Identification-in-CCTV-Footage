# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/
ENV/
.venv/

# Flask instance folder (contains config, uploads, etc.)
instance/

# Flask cache / sessions / compiled templates
*.db
*.sqlite3
*.pyc
*.pyo
*.pyd
*.log
*.pot
*.mo
*.swp
*.swo
*.bak
*.tmp
*.pid
*.seed

# Configuration files that may contain secrets
config.py
*.env
.env
.env.*

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# IDE / editor specific
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Mac / Linux / Windows system files
.DS_Store
Thumbs.db

# Logs
*.log

# Jupyter notebooks (optional)
*.ipynb_checkpoints/

# If using Docker
*.pid
docker-compose.override.yml

# If using migrations (like Flask-Migrate)
migrations/__pycache__/
migrations/*.pyc

# If using node for frontend inside Flask
node_modules/
frontend/build/
frontend/dist/
frontend/.env
